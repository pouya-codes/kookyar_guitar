     <ListPreference 
    android:title="@string/kookyar_pref_reference_title"
    android:defaultValue="440"
    android:key="ref"
    android:summary="@string/kookyar_pref_reference_summary"
    android:entries="@array/refArray"
    android:entryValues="@array/refArray"/>
        

</PreferenceScreen>
